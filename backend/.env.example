DATABASE_URL=postgresql+psycopg://trackline_app:CHANGE_ME@localhost:5432/trackline
COOKIE_SECURE=false
DOCS_ENABLED=true
SESSION_HOURS=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Where uploaded documents are kept. The folder must already exist.
# Forward slashes work on Windows and avoid escaping problems.
STORAGE_ROOT=C:/trackline-storage
MAX_UPLOAD_MB=10
# Times shown in history and approvals
DISPLAY_TIMEZONE=Asia/Singapore

# false: an Inventory Manager's changes apply at once, like an admin's. OIC/User changes always wait.
# true: an Inventory Manager's changes wait for an admin or another manager to approve them.
MANAGERS_NEED_APPROVAL=false
